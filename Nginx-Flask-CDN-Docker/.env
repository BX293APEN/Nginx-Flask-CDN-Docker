# ==========================================
# .env : compose.yml内で利用する環境変数の設定
# ==========================================

# ==========================================
# プロジェクトの設定
# 
# | 項目 | 内容 | 備考 |
# | --- | --- | --- |
# | COMPOSE_PROJECT_NAME | プロジェクト名 | 全て小文字にすること |
# | VOLUME | コンテナ内でマウントするホストディレクトリ | nginx.conf のテンプレートとログを置く |
# | TIME_ZONE | コンテナのタイムゾーン | - |
# 
# ==========================================

COMPOSE_PROJECT_NAME=nginx-flask-cdn-docker

VOLUME=./linux_data

TIME_ZONE=Asia/Tokyo

# ==========================================
# CDN (エッジnginx) の設定
# 
# | 項目 | 内容 | 備考 |
# | --- | --- | --- |
# | CDN_CONTAINER_NAME | コンテナ名 | - |
# | Dockerfile_DIR | Dockerfileがあるディレクトリ | 相対パス |
# | Dockerfile | Dockerfileの名前 | コンテナ起動時に使用 |
# | ENTRY_DIR | 作業用フォルダ | /${ENTRY_DIR} としてルート直下に作成する |
# | ENTRY_POINT | Dockerfileを使用後実行するスクリプト | - |
# | WS | 作業スペース | /${ENTRY_DIR}/${WS} にnginx一式をマウントする |
# | USER_NAME | nginxのワーカーを動かすユーザ名 | - |
# | CDN_PORT | ユーザがCDNにアクセスするポート番号 | http://(CDNのIPアドレス):${CDN_PORT} (80なら省略可) |
# 
# ==========================================

CDN_CONTAINER_NAME=Docker_Nginx_CDN
Dockerfile_DIR=.
Dockerfile=Dockerfile

ENTRY_DIR=Programs
ENTRY_POINT=start.sh

WS=WS

USER_NAME=PEN

CDN_PORT=80

# ==========================================
# origin (Nginx-Flask-Docker) と キャッシュの設定
# 
# | 項目 | 内容 | 備考 |
# | --- | --- | --- |
# | ORIGIN_HOST | originのIPアドレスまたはホスト名 | 別端末ならその端末のIPアドレス。同じ端末なら `host.docker.internal` (既定) |
# | ORIGIN_PORT | originの公開ポート | Nginx-Flask-Docker の .env の `PORT` と合わせること (既定 8080) |
# | CACHE_MAX_SIZE | キャッシュの最大容量 | 超えると古いものから削除される |
# | CACHE_INACTIVE | この期間アクセスされないキャッシュを削除する | 例: 7d (7日) |
# 
# | 構成 | ORIGIN_HOST | CDN_PORT | ORIGIN_PORT |
# | --- | --- | --- | --- |
# | 別の端末 | originの端末のIPアドレス | 80 | 8080 |
# | 同じ端末 | host.docker.internal | 80 | 8080 (origin の `PORT` と同じ値。CDN_PORT と重ならないこと) |
# 
# ==========================================

ORIGIN_HOST=host.docker.internal
ORIGIN_PORT=8080

CACHE_MAX_SIZE=1g
CACHE_INACTIVE=7d
